# Node
node_modules/
dist/
.env
.env.local

# Python (legado QGIS)
__pycache__/
*.pyc

# QGIS
*.gpkg
*.gpkg-*

# SO
.DS_Store
Thumbs.db

# Rascunho das sessões do Claude. A pasta existe no disco do João e viaja pelo
# OneDrive entre os PCs dele, mas não é código do projeto: são SQL de
# conferência, mensagens de commit em rascunho, capturas de tela e PNG de
# prancha. Três arquivos dela estavam COMMITADOS por engano desde setembro
# (registrado como pendência no próprio CLAUDE.md); saíram do índice em
# 2026-10-03, sem sair do disco.
Claude outputs/

# Backup do .git corrompido em 2026-09-19, caso ele reapareça. O conserto é
# trocar o .git inteiro (ver docs); o backup não é código.
.git-corrompido-*/

# Saída de comando que escapou para um arquivo.
/h

# Editores
.vscode/
.idea/

# Supabase CLI — estado local de `supabase link` (referência do projeto,
# tokens de sessão do pooler/versões), gerado automaticamente, não é código
supabase/.temp/
backend/supabase/.temp/

# Segredos e dados de exercício — NUNCA comitar
# Lista real de usuários (contém senhas); só o .exemplo.csv vai para o repo
backend/seed/usuarios_exercicio.csv
# Service role key (Admin API) — quem roda o seed passa por variável de
# ambiente na hora, nunca em arquivo. Ver backend/seed/criar_usuarios.mjs.
.env.seed

# frontend/config.js NÃO está mais aqui (Etapa 11): a SUPABASE_ANON_KEY é a
# "publishable key" do projeto — pública por design, porque quem decide o que
# ela pode ler/escrever é a RLS do banco, não a chave. Sem commitar este
# arquivo, o site publicado (sem etapa de build) não tem como carregar a
# configuração e nenhuma tela abre. Ver a explicação completa no cabeçalho de
# frontend/config.js e em CLAUDE.md, seção "Decisões da Etapa 11".
